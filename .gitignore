# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Test, coverage, type-checker, and linter output
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Local runtime output, including JSONL audit files
/var/
/audit/
/logs/
*.log

# Editor and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
